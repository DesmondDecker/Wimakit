# ============================================================
# WimaKit Backend — Environment Configuration
# Copy this file to: wimakit-backend/.env
# ============================================================

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:8081

# ── Database ────────────────────────────────────────────────
# CRITICAL: this exact string must be used by BOTH the server
# (npm run dev) and the seed script (npm run seed). If they ever
# differ even slightly, the seed script silently writes to a
# different database than the server reads from, and every
# seeded login fails with a generic "Invalid email or password"
# even though the data really is there.
MONGODB_URI=mongodb://127.0.0.1:27017/wimakit

# ── Auth (required — server will not start without these) ──
# Use long random strings in real deployments. For local dev any
# non-empty string works, but keep JWT_SECRET and
# JWT_REFRESH_SECRET DIFFERENT from each other.
# These are the ONLY two expiry vars the running code reads (in
# routes/auth.js's sendTokens()) — there used to be a second,
# unused set (JWT_EXPIRE / JWT_REFRESH_EXPIRE, no _IN suffix) in a
# dead utils/tokens.js file that nothing ever called; it's been
# removed so there's one source of truth instead of two that could
# drift out of sync.
JWT_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=90d

# ── Email (optional in dev — registration/reset still work,
# emails just won't actually send if these are blank) ────────
RESEND_API_KEY=
FROM_EMAIL=WimaKit <no-reply@wimakit.sl>
APP_NAME=WimaKit
APP_URL=http://localhost:8081

# ── Redis (optional — only needed for rate limiting / caching
# in prod; safe to leave blank locally) ──────────────────────
REDIS_URL=

# ── Image uploads (optional in dev; without these, uploads
# fall back to local disk storage under /uploads) ────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# API_URL is this server's OWN base URL — only used to build local-disk
# image links (http://<API_URL>/uploads/<file>) when Cloudinary isn't
# configured. This is deliberately separate from APP_URL above, which is
# the FRONTEND app's URL used for email links (reset-password, etc). They
# are different origins; do not point them at the same value in production.
# On Fly.io this defaults to https://<FLY_APP_NAME>.fly.dev automatically
# if left blank, so it's usually only needed for non-Fly deployments.
API_URL=

# ── Mobile money / payment webhooks (only needed to test real
# webhook signature verification; leave any placeholder value
# for local dev) ──────────────────────────────────────────────
ORANGE_WEBHOOK_SECRET=dev_placeholder
AFRIMONEY_WEBHOOK_SECRET=dev_placeholder
MONEYMI_WEBHOOK_SECRET=dev_placeholder
COD_CONFIRM_SECRET=dev_placeholder

# ── WhatsApp (optional) ──────────────────────────────────────
WHATSAPP_EVOLUTION_API_URL=
WHATSAPP_EVOLUTION_API_KEY=
WHATSAPP_EVOLUTION_INSTANCE=

# ── Misc ──────────────────────────────────────────────────────
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
